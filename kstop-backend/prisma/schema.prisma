generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  mentor
  hostel
  parent
}

enum Gender {
  Male
  Female
  PreferNotToSay
}

enum LeaveStatus {
  PENDING_PARENT
  PENDING_MENTOR
  APPROVED
  REJECTED
}

enum LeaveType {
  Medical
  Vacation
  FamilyEmergency
  Other
}

enum StaffGrievanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum StudentGrievanceStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum GrievanceCategory {
  Water
  Electrical
  Plumbing
  Transport
  Internet
  Cleaning
  Food
  Other
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Student-only fields
  rollNumber           String? @unique
  hostelId             String?
  gender               Gender?
  mentorName           String?
  attendancePercentage Int?
  academicDetails      String?

  // Mentor-only fields
  mentorRollRangeStart Int?
  mentorRollRangeEnd   Int?
  mentorGenderScope    Gender?

  // Hostel staff fields
  assignedHostelId String?

  // Parent-only fields
  childRollNumber String?

  // Relations
  hostel              Hostel?              @relation("StudentHostel", fields: [hostelId], references: [id])
  assignedHostel      Hostel?              @relation("HostelStaff", fields: [assignedHostelId], references: [id])
  leavesAsStudent     Leave[]              @relation("StudentLeaves")
  leavesAsMentor      Leave[]              @relation("MentorLeaves")
  grievancesAsStudent Grievance[]          @relation("StudentGrievances")
  grievancesAsMentor  Grievance[]          @relation("MentorGrievances")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  sentAnnouncements   Announcement[]
}

model Hostel {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  students     User[]              @relation("StudentHostel")
  hostelStaff  User[]              @relation("HostelStaff")
  grievances   Grievance[]
  messMenus    MessMenu[]
  leaveRecords HostelLeaveRecord[]
}

model Leave {
  id              String      @id @default(cuid())
  studentId       String
  mentorId        String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  purpose         String
  place           String
  contactNumber   String
  arrivalDetails  String?
  parentApproved  Boolean     @default(false)
  mentorApproved  Boolean     @default(false)
  status          LeaveStatus @default(PENDING_PARENT)
  rejectionReason String?
  qrToken         String?
  qrCode          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  student User @relation("StudentLeaves", fields: [studentId], references: [id])
  mentor  User @relation("MentorLeaves", fields: [mentorId], references: [id])

  @@index([studentId])
  @@index([mentorId])
}

model Grievance {
  id                 String                 @id @default(cuid())
  studentId          String
  hostelId           String
  mentorId           String
  title              String
  description        String
  category           GrievanceCategory
  staffStatus        StaffGrievanceStatus   @default(OPEN)
  studentStatus      StudentGrievanceStatus @default(PENDING)
  priorityScore      Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  staffResolvedAt    DateTime?
  studentRespondedAt DateTime?

  student User   @relation("StudentGrievances", fields: [studentId], references: [id])
  mentor  User   @relation("MentorGrievances", fields: [mentorId], references: [id])
  hostel  Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@index([studentId])
  @@index([priorityScore])
}

model MessMenu {
  id         String   @id @default(cuid())
  hostelId   String
  imageUrl   String
  uploadedBy String
  createdAt  DateTime @default(now())

  // Each menu belongs to one hostel.
  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
}

model HostelLeaveRecord {
  id                 String   @id @default(cuid())
  hostelId           String
  studentName        String
  rollNumber         String
  contactNumber      String
  leaveStartDate     DateTime
  leaveEndDate       DateTime
  parentsPhoneNumber String
  mentorName         String
  approved           Boolean  @default(true)
  source             String   @default("manual")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hostel Hostel @relation(fields: [hostelId], references: [id])

  @@index([hostelId])
  @@index([rollNumber])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  relatedId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  mentorId  String
  message   String
  createdAt DateTime @default(now())

  mentor User @relation(fields: [mentorId], references: [id])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ParentMessage {
  id        String   @id @default(cuid())
  parentId  String
  mentorId  String
  studentId String
  message   String
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([mentorId])
}
